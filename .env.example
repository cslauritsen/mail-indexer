# Settings for `mail-indexer serve`. Copy to /etc/mail-indexer.env and keep it readable by root only.
MAILDIR=/var/mail/chad/Maildir
DB=/var/lib/mail-index/mail.db
SKIP_FOLDERS=.Junk,.Trash

# Embeddings (Voyage AI)
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4
EMBED_DIM=1024

# Web application
BASE_URL=https://mail.example.com
LISTEN=127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=you@example.com

# Optional: natural-language interpretation of questions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
